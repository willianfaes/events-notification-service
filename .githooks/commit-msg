#!/usr/bin/env sh

msg_file="$1"
first_line=$(sed -n '1p' "$msg_file")

case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Initial commit")
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|refactor|test|chore|build|ci|perf)(\([a-z0-9._/-]+\))?(!)?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  cat <<'EOF'
Invalid commit message.

Use Conventional Commits:
type(scope): short summary

Examples:
feat(auth): add login endpoint
fix(events): prevent duplicate registrations
test(auth): add token service tests
EOF
  exit 1
fi
